# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Needed later for the
# cron job that reads Gmail on every user's behalf. Not used by the
# Connect Gmail flow yet. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud (OAuth client used by Supabase's Google provider) ---
# These are NOT read by the Next.js app directly — you paste them into
# the Supabase Dashboard under Authentication -> Providers -> Google.
# Listed here only so everything you need is in one place.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Anthropic (used starting with the AI extraction step) ------------
ANTHROPIC_API_KEY=

# --- Resend (used starting with the weekly digest email step) ---------
RESEND_API_KEY=
