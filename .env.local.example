# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Needed later for the
# cron job that reads Gmail on every user's behalf. Not used by the
# Connect Gmail flow yet. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud (OAuth client) ---
# Same Client ID/Secret you paste into the Supabase Dashboard under
# Authentication -> Providers -> Google. They're needed here too because
# the Gmail sync route refreshes its own access token server-side
# (independent of the user's browser session) using these plus the
# refresh_token stored in google_tokens.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Anthropic (required — powers conversation intelligence and the
# "Draft follow-up" feature via the Claude API) -------------------------
ANTHROPIC_API_KEY=

# --- Resend (used starting with the weekly digest email step) ---------
RESEND_API_KEY=
